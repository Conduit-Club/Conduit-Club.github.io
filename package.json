{
  "name": "conduit-club-minecraft-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "Conduit Club Minecraft 服务器中文 Docusaurus 文档站。",
  "scripts": {
    "live2d:scan": "node generate-live2d-manifest.mjs",
    "prestart": "node generate-live2d-manifest.mjs",
    "start": "node node_modules/@docusaurus/core/bin/docusaurus.mjs start --host 0.0.0.0 --port 4173",
    "prebuild": "node generate-live2d-manifest.mjs",
    "build": "node node_modules/@docusaurus/core/bin/docusaurus.mjs build",
    "preserve": "node generate-live2d-manifest.mjs",
    "serve": "node node_modules/@docusaurus/core/bin/docusaurus.mjs serve --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@docusaurus/core": "^3.8.1",
    "@docusaurus/preset-classic": "^3.8.1",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 3 safari version"
    ]
  }
}
